# Local workerd development only. Deployed Workers should use the HYPERDRIVE binding.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/omr

# Exactly 32 random bytes encoded as 64 hexadecimal characters or base64url.
DEVICE_CREDENTIAL_WRAPPING_KEY=

# Separate 32-byte key for encrypted execution results and approval parameters.
EXECUTION_RESULT_WRAPPING_KEY=

# Independent PlugFn credential encryption secret (exactly 32 bytes as 64 hex characters).
PLUGFN_ENCRYPTION_KEY=

# Optional OAuth applications. A provider is OAuth-connectable only when both
# values for its application are present. Google and Microsoft applications are
# shared by their respective provider families.
PLUGFN_GITHUB_CLIENT_ID=
PLUGFN_GITHUB_CLIENT_SECRET=
PLUGFN_LINEAR_CLIENT_ID=
PLUGFN_LINEAR_CLIENT_SECRET=
PLUGFN_NOTION_CLIENT_ID=
PLUGFN_NOTION_CLIENT_SECRET=
PLUGFN_GOOGLE_CLIENT_ID=
PLUGFN_GOOGLE_CLIENT_SECRET=
PLUGFN_MICROSOFT_CLIENT_ID=
PLUGFN_MICROSOFT_CLIENT_SECRET=
PLUGFN_SLACK_CLIENT_ID=
PLUGFN_SLACK_CLIENT_SECRET=
