# Local workerd development only. Deployed Workers should use the HYPERDRIVE binding.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/omr

# Exactly 32 random bytes encoded as 64 hexadecimal characters or base64url.
DEVICE_CREDENTIAL_WRAPPING_KEY=

# Separate 32-byte key for encrypted execution results and approval parameters.
EXECUTION_RESULT_WRAPPING_KEY=

# Independent PlugFn credential encryption secret (exactly 32 bytes as 64 hex characters).
PLUGFN_ENCRYPTION_KEY=

# Personal OpenRouter vault. Leave disabled until OMR-15 validates disposable
# migration, staged secrets, authenticated browser use, and rollback.
OMR_OPENROUTER_VAULT_ENABLED=false
# Set true only after OMR-15 has verified the dedicated Hyperdrive configuration
# reports caching.disabled=true (local direct PostgreSQL has no Hyperdrive cache).
OMR_OPENROUTER_VAULT_CACHE_DISABLED_CONFIRMED=false
# JSON object of key-id to independent 32-byte hex key, e.g. {"v1":"<64 hex>"}.
# Keep old entries while any row still uses them; never commit real values.
OPENROUTER_VAULT_KEYS=
OPENROUTER_VAULT_ACTIVE_KEY_ID=
# Dedicated vault role connection, granted only vault table DML and schema usage.
# On Workers use a separate OPENROUTER_VAULT_HYPERDRIVE binding instead.
OPENROUTER_VAULT_DATABASE_URL=

# Optional OAuth applications. A provider is OAuth-connectable only when both
# values for its application are present. Google and Microsoft applications are
# shared by their respective provider families.
PLUGFN_GITHUB_CLIENT_ID=
PLUGFN_GITHUB_CLIENT_SECRET=
# Separate rollout gate: leave false until OMR-15 records live GitHub sandbox acceptance.
# OAuth credentials alone do not expose GitHub v1 actions.
OMR_GITHUB_V1_ENABLED=false
PLUGFN_LINEAR_CLIENT_ID=
PLUGFN_LINEAR_CLIENT_SECRET=
# Separate rollout gate: OMR-15 enables this only after live Linear sandbox acceptance.
OMR_LINEAR_V1_ENABLED=false
PLUGFN_NOTION_CLIENT_ID=
PLUGFN_NOTION_CLIENT_SECRET=
# Keep Notion v1 unavailable until OMR-15 records live sandbox acceptance.
OMR_NOTION_V1_ENABLED=false
PLUGFN_GOOGLE_CLIENT_ID=
PLUGFN_GOOGLE_CLIENT_SECRET=
PLUGFN_MICROSOFT_CLIENT_ID=
PLUGFN_MICROSOFT_CLIENT_SECRET=
PLUGFN_SLACK_CLIENT_ID=
PLUGFN_SLACK_CLIENT_SECRET=
# Separate rollout gate: Slack OAuth credentials alone do not expose v1 actions.
# Leave false until OMR-15 records live Slack sandbox acceptance.
OMR_SLACK_V1_ENABLED=false
