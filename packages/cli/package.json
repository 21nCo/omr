    "test": "vitest run"
  },
  "devDependencies": {
    "@oh-my-router/client": "0.0.0",
    "@oh-my-router/client-access": "0.0.0",
    "@oh-my-router/tools": "0.0.0",
    "esbuild": "^0.28.1"
  }
}
