{
  "name": "@oh-my-router/cli",
  "version": "0.1.0",
  "type": "module",
  "files": ["dist/bin.js", "dist/bin.d.ts", "README.md"],
  "engines": { "node": ">=22.0.0" },
  "bin": {
    "omr": "./dist/bin.js"
