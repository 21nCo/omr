{
  "name": "omr-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "npm run dev --workspace=@oh-my-router/web",
    "typecheck": "turbo run typecheck",
    "test": "npm run test:prepare && vitest run",
    "test:prepare": "turbo run build --filter='./packages/*'",
    "test:phase-00": "vitest run tests/acceptance/phase-00.test.ts",
    "sf:status": "node scripts/superfunctions.mjs status",
    "sf:install": "node scripts/superfunctions.mjs install",
    "sf:build": "node scripts/superfunctions.mjs build",
    "sf:link": "node scripts/superfunctions.mjs link",
    "sf:smoke": "node scripts/superfunctions.mjs smoke"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.4",
  "overrides": {
    "cookie": "0.7.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^22.18.6",
    "svelte": "^5.57.1",
    "svelte-check": "^4.3.4",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "vite": "^7.3.1",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.2"
  }
}
