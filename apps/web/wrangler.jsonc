{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "omr-web",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": [
      "DEVICE_CREDENTIAL_WRAPPING_KEY",
      "EXECUTION_RESULT_WRAPPING_KEY",
      "PLUGFN_ENCRYPTION_KEY"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "env": {
    "staging": {
      "name": "omr-web-staging",
      "account_id": "c801efc2879825babdb9b2534199c4dd",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "omr-staging.21n.dev",
          "custom_domain": true
        }
      ],
      "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
      "vars": {
        "OMR_PUBLIC_ORIGIN": "https://omr-staging.21n.dev",
        "OMR_MCP_BROWSER_ORIGINS": "https://chatgpt.com,https://claude.ai,https://vscode.dev"
      },
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "666d8b07eb9b4ac382c61fd7e483107e"
        }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "7a0710de99e543cfbc5b509003301352"
        }
      ],
      "secrets": {
        "required": [
          "DEVICE_CREDENTIAL_WRAPPING_KEY",
          "EXECUTION_RESULT_WRAPPING_KEY",
          "PLUGFN_ENCRYPTION_KEY"
        ]
      }
    }
  }
}
