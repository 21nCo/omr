{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "omr-web",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": [
      "DEVICE_CREDENTIAL_WRAPPING_KEY",
      "EXECUTION_RESULT_WRAPPING_KEY",
      "PLUGFN_ENCRYPTION_KEY"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "env": {
    "staging": {
      "name": "omr-web-staging",
      "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
      "vars": {
        "OMR_PUBLIC_ORIGIN": "https://omr-web-staging.21n.workers.dev"
      },
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "4ec5a09da50c4a7594830407c1fd2199"
        }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "35547f903fed4e35b73e78ddf65921ec"
        }
      ],
      "secrets": {
        "required": [
          "DEVICE_CREDENTIAL_WRAPPING_KEY",
          "EXECUTION_RESULT_WRAPPING_KEY",
          "PLUGFN_ENCRYPTION_KEY"
        ]
      }
    }
  }
}
